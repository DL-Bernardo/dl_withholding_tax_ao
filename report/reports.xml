<odoo>
    <template id="report_invoice_document_inherit_withholding" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='total']" position="replace">
            <div id="total" class="row">
                <!-- Coluna da Esquerda: Resumo de Retenções -->
                <div class="col-6">
                    <table class="table table-sm" t-if="o.withholding_by_group">
                        <thead>
                            <tr>
                                <th>
                                    <strong>Quadro de Retenções</strong>
                                </th>
                                <th class="text-right">Valor Base</th>
                                <th class="text-right">Valor a Reter</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.withholding_by_group" t-as="wht_group">
                                <td>
                                    <span t-esc="wht_group[0]"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="wht_group[1]" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="wht_group[2]" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Coluna da Direita: Totais Manuais -->
                <div class="col-6 ml-auto">
                    <table class="table table-sm">
                        <!-- Untaxed Amount -->
                        <tr class="border-black o_subtotal">
                            <td><strong>Valor sem Impostos</strong></td>
                            <td class="text-right">
                                <span t-field="o.amount_untaxed"/>
                            </td>
                        </tr>
                        <!-- Taxes -->
                        <t t-foreach="o.amount_by_group" t-as="amount_by_group">
                            <tr t-if="amount_by_group[1]">
                                <td>
                                    <span t-esc="amount_by_group[0]"/>
                                </td>
                                <td class="text-right o_price_total">
                                    <span t-esc="amount_by_group[1]" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                        <!-- Total -->
                        <tr class="border-black o_total">
                            <td><strong>Total</strong></td>
                            <td class="text-right">
                                <span t-field="o.amount_total"/>
                            </td>
                        </tr>
                        <!-- Withholding Amount -->
                        <tr t-if="o.withholding_amount > 0" style="border-top: 1px solid black;">
                            <td><strong>Valor da Retenção</strong></td>
                            <td class="text-right">
                                <span>- </span>
                                <span t-field="o.withholding_amount"/>
                            </td>
                        </tr>
                        <!-- Net Amount to Pay -->
                        <tr class="border-black" t-if="o.withholding_amount > 0">
                            <td><strong>Líquido a Pagar</strong></td>
                            <td class="text-right">
                                <span t-field="o.net_amount"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
    </template>
</odoo>